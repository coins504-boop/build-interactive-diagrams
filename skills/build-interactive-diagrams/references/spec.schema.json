{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable interactive diagram specification 1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "entry",
    "nodes",
    "edges",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
    },
    "context": {
      "type": "object"
    },
    "maxSteps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "entry": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "context": {
            "type": "object"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenario",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scenario": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "mode": {
            "enum": [
              "normal",
              "failure",
              "wait"
            ]
          },
          "decisions": {
            "type": "array",
            "items": {
              "enum": [
                "approve",
                "reject"
              ]
            }
          },
          "expect": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "status": {
                "type": "string"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
              },
              "context": {
                "type": "object"
              },
              "traceIncludes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
                }
              },
              "traceExcludes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "field",
            "op",
            "value"
          ],
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^(mode|decision|context\\..+)$"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "exists",
                "in"
              ]
            },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "const": "set"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "path",
            "from"
          ],
          "properties": {
            "op": {
              "const": "copy"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "from": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "path"
          ],
          "properties": {
            "op": {
              "const": "increment"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "by": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "const": "append"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "path"
          ],
          "properties": {
            "op": {
              "const": "delete"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "label",
        "role",
        "docs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "container",
            "source",
            "step",
            "router",
            "wait",
            "terminal",
            "store"
          ]
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "docs": {
          "type": "object",
          "required": [
            "goal"
          ],
          "properties": {
            "goal": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "normal",
            "failure",
            "wait",
            "resume",
            "reject",
            "data"
          ]
        },
        "when": {
          "$ref": "#/$defs/condition"
        }
      }
    }
  }
}
