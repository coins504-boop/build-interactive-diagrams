  "edges": [
    {
      "id": "candidateBuild",
      "source": "candidate",
      "target": "compile",
      "label": "",
      "kind": "normal"
    },
    {
      "id": "buildTest",
      "source": "compile",
      "target": "tests",
      "label": "",
      "kind": "normal"
    },
    {
      "id": "testFails",
      "source": "tests",
      "target": "retry",
      "label": "测试失败",
      "kind": "failure",
      "when": {
        "all": [
          {
            "field": "mode",
            "op": "eq",
            "value": "failure"
          },
          {
            "field": "context.attempts",
            "op": "lte",
            "value": 2
          }
        ]
      }
    },
    {
      "id": "testPasses",
      "source": "tests",
      "target": "releaseGate",
      "label": "测试通过",
      "kind": "normal"
    },
    {
      "id": "recordFailure",
      "source": "retry",
      "target": "retryGate",
      "label": "",
      "kind": "normal"
    },
    {
      "id": "tryAgain",
      "source": "retryGate",
      "target": "compile",
      "label": "还有一次重试",
      "kind": "resume",
      "when": {
        "field": "context.attempts",
        "op": "lt",
        "value": 2
      }
    },
    {
      "id": "exhausted",
      "source": "retryGate",
      "target": "failed",
      "label": "重试耗尽",
      "kind": "failure"
    },
    {
      "id": "manualRelease",
      "source": "releaseGate",
      "target": "review",
      "label": "等待审批",
      "kind": "wait",
      "when": {
        "field": "mode",
        "op": "eq",
        "value": "wait"
      }
    },
    {
      "id": "autoRelease",
      "source": "releaseGate",
      "target": "deploy",
      "label": "",
      "kind": "normal"
    },
    {
      "id": "releaseApprove",
      "source": "review",
      "target": "deploy",
      "label": "批准",
      "kind": "resume",
      "when": {
        "field": "decision",
        "op": "eq",
        "value": "approve"
      }
    },
    {
      "id": "releaseReject",
      "source": "review",
      "target": "rejected",
      "label": "拒绝",
      "kind": "reject",
      "when": {
        "field": "decision",
        "op": "eq",
        "value": "reject"
      }
    },
    {
      "id": "deployFinish",
      "source": "deploy",
      "target": "success",
      "label": "",
      "kind": "normal"
    }
